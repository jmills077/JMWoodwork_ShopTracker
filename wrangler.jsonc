// Cloudflare Workers configuration for Shop Tracker.
// `npm run dev` runs all of this locally (D1 and the cron are simulated on your machine);
// `npm run deploy` publishes it. See DEPLOYMENT.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jmwoodwork-shoptracker",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  // The jmwood.work Cloudflare account, so wrangler doesn't have to ask when a login sees more than one.
  "account_id": "a8394270fff8df4bb9a6c767515fdb23",
  "observability": { "enabled": true },

  // Builds the browser script into public/ before every `wrangler dev` / `wrangler deploy`.
  "build": { "command": "npm run build:client", "watch_dir": "src" },

  // Stylesheet and browser script. Everything else goes through the Worker (and its login).
  "assets": { "directory": "./public", "binding": "ASSETS" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shop-tracker",
      // The shop-tracker database in the jmwood.work Cloudflare account. If you recreate it,
      // replace this with the id printed by `npx wrangler d1 create shop-tracker`.
      // Local development ignores it.
      "database_id": "960ca1a4-400c-438f-b6cd-100ab73354a0",
      "migrations_dir": "migrations"
    }
  ],

  // Workers AI, for reading receipt photos. Even under `npm run dev` this runs on Cloudflare
  // (so it needs `npx wrangler login`); everything else stays local.
  "ai": { "binding": "AI", "remote": true },

  // Weekly supplier price check: Mondays, about 5 am Eastern.
  "triggers": { "crons": ["17 9 * * 1"] }

  // Secrets (not in this file): APP_PASSWORD, TODOIST_TOKEN. Locally, put them in .dev.vars.
}
